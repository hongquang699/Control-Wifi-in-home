{
  "security_version": "2.0.0",
  "environment": "production",
  "https_enforced": true,
  "waf": {
    "enabled": true,
    "block_sqli": true,
    "block_xss": true,
    "block_path_traversal": true,
    "block_command_injection": true
  },
  "rate_limiting": {
    "enabled": true,
    "login_limit_per_minute": 5,
    "download_limit_per_minute": 10,
    "api_limit_per_minute": 100,
    "ban_duration_seconds": 900
  },
  "firewall_rules": {
    "enabled": true,
    "max_requests_per_ip": 100,
    "rate_limit_window_seconds": 60,
    "page_429_warning": "Bạn bấm quá nhanh vui lòng thử lại",
    "bot_ban_threshold": 1000,
    "bot_ban_enabled": true,
    "bot_ban_duration_seconds": 2592000,
    "host_firewall_integration": true
  },
  "authentication": {
    "password_hash_algorithm": "PBKDF2-HMAC-SHA256",
    "pbkdf2_iterations": 200000,
    "session_ttl_seconds": 7200,
    "max_failed_attempts": 5,
    "lockout_duration_seconds": 900
  },
  "rbac": {
    "roles": ["ADMIN", "OPERATOR", "USER"],
    "default_role": "USER"
  },
  "audit_logging": {
    "enabled": true,
    "log_file": "logs/audit/audit.log",
    "mask_sensitive_data": true
  },
  "backup": {
    "retention_count": 7,
    "storage_dir": "backups/"
  }
}
